# Scientific data and intermediates: never version raw reads or assemblies.
*.fastq*
*.fq
*.fq.gz
*.fasta*
*.fa
*.fa.gz
*.fna*
*.gfa*
*.bam*
*.sam
*.cram*
*.vcf*
*.bcf*
*.paf*
*.mmi
*.fai
*.pairs*
*.cool
*.mcool
*.pretext
*.meryl/
*.merylData
*.merylIndex
*.bin
*.pod5
*.fast5
*.sra
*.h5
*.hdf5
*.zip
*.tar*
*.gz
*.bz2
*.xz
*.so
*.so.*
*.o
*.exe
*.out
*.err
*.log
*.wig
*.bed
# Large/unreviewed figures; explicitly permit selected small figures through manifest.
*.pdf
*.tif*
*.svg
*.png
!figures/**/*.svg
!figures/**/*.png
inputs/
raw_data/
data/
databases/
tools/
logs/
tmp/
.snakemake/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/
.DS_Store
# Secrets and local machine configuration
.env
.env.*
*.pem
*.key
id_rsa*
id_ed25519*
credentials*
*token*.txt
config.local.*
.netrc
.git-credentials
